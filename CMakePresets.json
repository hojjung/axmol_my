{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "web-release",
      "displayName": "Axmol Stylized Web (WebGL2)",
      "description": "Axmol WebGL2 forward stylized product runtime.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stylized-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AX_BUILD_TESTS": "OFF",
        "AX_RENDER_API": "gl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "configuration": "Release"
    }
  ]
}
